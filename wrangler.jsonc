{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only: no worker script and no bindings.
  "name": "ripdpi-site",
  "compatibility_date": "2026-11-01",
  // Serve only on ripdpi.dev. A custom domain makes its own DNS record and certificate.
  "routes": [{ "pattern": "ripdpi.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build/client"
  }
}
