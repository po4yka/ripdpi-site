{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets, plus one small Worker that answers Accept: text/markdown on "/" (worker/index.ts).
  "name": "ripdpi-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Serve only on ripdpi.dev. A custom domain makes its own DNS record and certificate.
  "routes": [{ "pattern": "ripdpi.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // The Worker runs only for the home page; every other path is served from the assets without it.
    "run_worker_first": ["/"]
  }
}
