/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  # scripts/csp-hashes.mjs replaces 'unsafe-inline' in script-src with the hashes of the inline scripts after the build.
  # The cloudflareinsights origins are for the Web Analytics beacon that Cloudflare injects into the page.
  # script-src, worker-src and img-src allow blob: because the 3D text (troika) loads its glyph code from blob URLs in a worker.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Point agents to the Markdown copy, the site summary, the sitemap and the skills index (RFC 8288).
/
  Link: </index.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap", </.well-known/agent-skills/index.json>; rel="agent-skills"; type="application/json", </.well-known/ard.json>; rel="ard"; type="application/json"

# Agentic Resource Discovery manifests: registries and agents fetch them cross-origin.
/.well-known/ard.json
  Access-Control-Allow-Origin: *
/.well-known/ai-catalog.json
  Access-Control-Allow-Origin: *
